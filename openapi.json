{
  "openapi": "3.1.0",
  "info": {
    "title": "FirstGlance API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/tests": {
      "post": {
        "tags": [
          "tests"
        ],
        "summary": "Create Test",
        "operationId": "create_test_api_tests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tests/{public_id}": {
      "get": {
        "tags": [
          "tests"
        ],
        "summary": "Get Test",
        "operationId": "get_test_api_tests__public_id__get",
        "parameters": [
          {
            "name": "public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Public Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tests/{public_id}/confirm": {
      "post": {
        "tags": [
          "tests"
        ],
        "summary": "Confirm Test",
        "operationId": "confirm_test_api_tests__public_id__confirm_post",
        "parameters": [
          {
            "name": "public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Public Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/t/{public_id}": {
      "get": {
        "tags": [
          "test page"
        ],
        "summary": "Get Test Page",
        "operationId": "get_test_page_api_t__public_id__get",
        "parameters": [
          {
            "name": "public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Public Id"
            }
          },
          {
            "name": "participant",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Participant"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestPageOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/t/{public_id}/answers": {
      "post": {
        "tags": [
          "test page"
        ],
        "summary": "Submit Answer",
        "operationId": "submit_answer_api_t__public_id__answers_post",
        "parameters": [
          {
            "name": "public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Public Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestAnswerIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/landing-copy": {
      "get": {
        "tags": [
          "test page"
        ],
        "summary": "Landing Copy",
        "operationId": "landing_copy_api_landing_copy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeroCopy"
                }
              }
            }
          }
        }
      }
    },
    "/api/self-test": {
      "get": {
        "tags": [
          "test page"
        ],
        "summary": "Self Test",
        "operationId": "self_test_api_self_test_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelfTestOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/whop": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Whop Webhook",
        "operationId": "whop_webhook_api_webhooks_whop_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/support": {
      "post": {
        "tags": [
          "support"
        ],
        "summary": "Contact",
        "operationId": "contact_api_support_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/company/log": {
      "get": {
        "tags": [
          "company"
        ],
        "summary": "Company Log",
        "operationId": "company_log_api_company_log_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AgentName"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DecisionOut"
                  },
                  "title": "Response Company Log Api Company Log Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/company/stats": {
      "get": {
        "tags": [
          "company"
        ],
        "summary": "Stats",
        "operationId": "stats_api_company_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/api/dev/fake-pay/{public_id}": {
      "get": {
        "tags": [
          "dev"
        ],
        "summary": "Fake Pay",
        "description": "Pretend Whop checkout: queues exactly the job a real payment webhook queues.",
        "operationId": "fake_pay_api_dev_fake_pay__public_id__get",
        "parameters": [
          {
            "name": "public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Public Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dev/fake-answers/{public_id}": {
      "post": {
        "tags": [
          "dev"
        ],
        "summary": "Fake Answers",
        "description": "Pretend Terac participants answered (rewrite is understood more often), so grading can be tested.",
        "operationId": "fake_answers_api_dev_fake_answers__public_id__post",
        "parameters": [
          {
            "name": "public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Public Id"
            }
          },
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "title": "N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dev/run-worker": {
      "post": {
        "tags": [
          "dev"
        ],
        "summary": "Run Worker",
        "description": "Run every agent once + drain jobs (instead of waiting for the schedule).",
        "operationId": "run_worker_api_dev_run_worker_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentName": {
        "type": "string",
        "enum": [
          "ceo",
          "growth",
          "support",
          "tester",
          "finance",
          "compliance",
          "research"
        ],
        "title": "AgentName"
      },
      "Arm": {
        "type": "string",
        "enum": [
          "original",
          "rewrite"
        ],
        "title": "Arm"
      },
      "ArmResult": {
        "properties": {
          "responses": {
            "type": "integer",
            "title": "Responses"
          },
          "understood": {
            "type": "integer",
            "title": "Understood",
            "description": "Answers Claude graded as matching what the company does"
          },
          "understood_rate": {
            "type": "number",
            "title": "Understood Rate",
            "description": "understood / responses, 0..1"
          },
          "avg_signup": {
            "type": "number",
            "title": "Avg Signup",
            "description": "Average 'would you sign up?' 1-5"
          },
          "sample_answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sample Answers",
            "description": "Up to 5 verbatim answers"
          }
        },
        "type": "object",
        "required": [
          "responses",
          "understood",
          "understood_rate",
          "avg_signup"
        ],
        "title": "ArmResult"
      },
      "CheckoutOut": {
        "properties": {
          "checkout_url": {
            "type": "string",
            "title": "Checkout Url"
          }
        },
        "type": "object",
        "required": [
          "checkout_url"
        ],
        "title": "CheckoutOut"
      },
      "CreateTestRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "examples": [
              "https://example.com"
            ]
          },
          "what_you_do": {
            "type": "string",
            "minLength": 5,
            "title": "What You Do",
            "description": "One sentence: what does your company do, for whom?"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "url",
          "what_you_do",
          "email"
        ],
        "title": "CreateTestRequest"
      },
      "DecisionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentName"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "agent",
          "action",
          "reason",
          "data",
          "created_at"
        ],
        "title": "DecisionOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeroCopy": {
        "properties": {
          "headline": {
            "type": "string",
            "title": "Headline"
          },
          "subhead": {
            "type": "string",
            "title": "Subhead",
            "default": ""
          },
          "cta": {
            "type": "string",
            "title": "Cta",
            "description": "Button text, e.g. \"Start free trial\"",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "headline"
        ],
        "title": "HeroCopy",
        "description": "The top of a landing page: what a visitor sees in the first 5 seconds."
      },
      "OkOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "title": "OkOut"
      },
      "SelfTestOut": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TestStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "original": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeroCopy"
              },
              {
                "type": "null"
              }
            ]
          },
          "rewrite": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeroCopy"
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TestResults"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "SelfTestOut",
        "description": "Our own landing page's before/after (Research agent), for the Company Log page."
      },
      "Stats": {
        "properties": {
          "revenue_usd": {
            "type": "number",
            "title": "Revenue Usd"
          },
          "payments": {
            "type": "integer",
            "title": "Payments"
          },
          "refunds": {
            "type": "integer",
            "title": "Refunds"
          },
          "tests_created": {
            "type": "integer",
            "title": "Tests Created"
          },
          "tests_paid": {
            "type": "integer",
            "title": "Tests Paid"
          },
          "tests_delivered": {
            "type": "integer",
            "title": "Tests Delivered"
          },
          "rewrite_win_rate": {
            "type": "number",
            "title": "Rewrite Win Rate",
            "description": "delivered customer tests where our rewrite won, 0..1"
          },
          "conversion_rate": {
            "type": "number",
            "title": "Conversion Rate",
            "description": "paid tests / created tests"
          },
          "price_usd": {
            "type": "number",
            "title": "Price Usd"
          }
        },
        "type": "object",
        "required": [
          "revenue_usd",
          "payments",
          "refunds",
          "tests_created",
          "tests_paid",
          "tests_delivered",
          "rewrite_win_rate",
          "conversion_rate",
          "price_usd"
        ],
        "title": "Stats"
      },
      "SupportRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 2,
            "title": "Message"
          },
          "test_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Id"
          }
        },
        "type": "object",
        "required": [
          "email",
          "message"
        ],
        "title": "SupportRequest"
      },
      "TestAnswerIn": {
        "properties": {
          "participant_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Ref",
            "description": "teracSubmissionId from the task URL"
          },
          "arm": {
            "$ref": "#/components/schemas/Arm",
            "description": "The arm the test page was given by GET /api/t/{id}"
          },
          "answer": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Answer",
            "description": "\"What does this company do?\""
          },
          "signup": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Signup",
            "description": "\"How likely are you to sign up?\" 1-5"
          }
        },
        "type": "object",
        "required": [
          "arm",
          "answer",
          "signup"
        ],
        "title": "TestAnswerIn"
      },
      "TestOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "public id (never the DB integer)"
          },
          "status": {
            "$ref": "#/components/schemas/TestStatus"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "what_you_do": {
            "type": "string",
            "title": "What You Do"
          },
          "original": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeroCopy"
              },
              {
                "type": "null"
              }
            ]
          },
          "rewrite": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeroCopy"
              },
              {
                "type": "null"
              }
            ]
          },
          "price_usd": {
            "type": "number",
            "title": "Price Usd"
          },
          "responses_so_far": {
            "type": "integer",
            "title": "Responses So Far",
            "default": 0
          },
          "results": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TestResults"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "url",
          "what_you_do",
          "price_usd",
          "created_at"
        ],
        "title": "TestOut",
        "description": "A customer's test, shown on the order page and the report page."
      },
      "TestPageOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "arm": {
            "$ref": "#/components/schemas/Arm"
          },
          "hero": {
            "$ref": "#/components/schemas/HeroCopy"
          },
          "seconds": {
            "type": "integer",
            "title": "Seconds",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "id",
          "arm",
          "hero"
        ],
        "title": "TestPageOut",
        "description": "What one Terac participant sees on /t/{id}: ONE arm, for `seconds` seconds."
      },
      "TestResults": {
        "properties": {
          "original": {
            "$ref": "#/components/schemas/ArmResult"
          },
          "rewrite": {
            "$ref": "#/components/schemas/ArmResult"
          },
          "winner": {
            "$ref": "#/components/schemas/Winner"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "One sentence, e.g. \"3/5 understood yours, 5/5 understood ours\""
          }
        },
        "type": "object",
        "required": [
          "original",
          "rewrite",
          "winner",
          "summary"
        ],
        "title": "TestResults"
