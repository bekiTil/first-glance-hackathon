  "components": {
    "schemas": {
      "AgentName": {
        "type": "string",
        "enum": [
          "ceo",
          "growth",
          "support",
          "watcher",
          "finance",
          "compliance",
          "research"
        ],
        "title": "AgentName"
      },
      "Body_twilio_sms_api_webhooks_sms_post": {
        "properties": {
          "From": {
            "type": "string",
            "title": "From"
          },
          "Body": {
            "type": "string",
            "title": "Body",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "From"
        ],
        "title": "Body_twilio_sms_api_webhooks_sms_post"
      },
      "Checklist": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The customer's original sentence"
          },
          "performer": {
            "type": "string",
            "title": "Performer",
            "description": "Team/artist/show, e.g. \"New York Knicks\""
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          },
          "date_from": {
            "type": "string",
            "format": "date",
            "title": "Date From"
          },
          "date_to": {
            "type": "string",
            "format": "date",
            "title": "Date To"
          },
          "weekdays": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Weekdays",
            "description": "0=Mon..6=Sun; empty = any day"
          },
          "max_price_per_ticket": {
            "type": "number",
            "title": "Max Price Per Ticket",
            "description": "USD per ticket, all-in including fees"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity",
            "default": 1
          },
          "exclude_sections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exclude Sections",
            "description": "e.g. [\"upper level\"]"
          },
          "preferences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferences",
            "description": "Soft wishes; ranked, never guaranteed"
          }
        },
        "type": "object",
        "required": [
          "query",
          "performer",
          "date_from",
          "date_to",
          "max_price_per_ticket"
        ],
        "title": "Checklist",
        "description": "What the customer confirms before paying. A match = every field below is satisfied."
      },
      "CheckoutOut": {
        "properties": {
          "checkout_url": {
            "type": "string",
            "title": "Checkout Url"
          }
        },
        "type": "object",
        "required": [
          "checkout_url"
        ],
        "title": "CheckoutOut"
      },
      "CreateWatchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "title": "Query",
            "examples": [
              "Knicks under $80, any Friday in November, 2 seats"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "description": "E.164, e.g. +12125551234"
          },
          "sms_consent": {
            "type": "boolean",
            "title": "Sms Consent",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query",
          "email"
        ],
        "title": "CreateWatchRequest"
      },
      "DecisionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentName"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "agent",
          "action",
          "reason",
          "data",
          "created_at"
        ],
        "title": "DecisionOut"
      },
      "EventInfo": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/TicketSource"
          },
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "source",
          "external_id",
          "name",
          "starts_at",
          "venue",
          "url"
        ],
        "title": "EventInfo"
      },
      "FreeEvent": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "when": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "When"
          },
          "where": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Where"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "FreeEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "LoginRequest"
      },
      "OkOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "title": "OkOut"
      },
