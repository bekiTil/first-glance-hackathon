# Copy to .env (never commit .env). With every MOCK_* = true the app runs with no keys.
# Flip a MOCK_* to false only after you've put that service's keys in YOUR .env.

# ---------- Core (Bereket) ----------
APP_ENV=dev
# Local default is SQLite (backend/dev.db). On Railway, set to the Postgres URL Railway provides.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Terac participants open {PUBLIC_WEB_URL}/t/<id>, so in production this MUST be the public https site.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=change-me

# ---------- Claude (shared key; ask in team chat) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MOCK_LLM=true

# ---------- Page reading + testing (Bereket) ----------
SOLARI_API_KEY=
MOCK_SOLARI=true
TEST_PARTICIPANTS=4
TEST_SECONDS=10
MIN_ANSWERS_PER_ARM=2
TEST_TIMEOUT_MINUTES=120

# ---------- Whop: NATNAEL ONLY ----------
# Natnael's Whop account receives all revenue. Only Natnael sets these, on his machine
# and in Railway. Everyone else keeps MOCK_WHOP=true.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=
WHOP_WEBHOOK_SECRET=
MOCK_WHOP=true

# ---------- Email + text (Natnael) ----------
RESEND_API_KEY=
EMAIL_FROM=FirstGlance <hello@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MOCK_NOTIFY=true

# ---------- Growth + research (Yared) ----------
EXA_API_KEY=
MOCK_EXA=true
# Terac REST API key: Terac dashboard -> organization settings -> API keys
TERAC_API_KEY=
MOCK_TERAC=true
# Growth agent posts to Bluesky if set (Settings -> App passwords). Empty = posts only on our site.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---------- Guardrails (Bereket) ----------
STARTING_PRICE_USD=15
PRICE_MIN_USD=5
PRICE_MAX_USD=30
PRICE_CHANGE_COOLDOWN_MINUTES=60
AD_BUDGET_USD_PER_DAY=20
KILL_SWITCH=false
