# Copy to .env (never commit .env). With every MOCK_* = true the app runs with no keys.
# Flip a MOCK_* to false only after you've put that service's keys in YOUR .env.

# ---------- Core (Bereket) ----------
APP_ENV=dev
# Local default is SQLite (backend/dev.db). On Railway, set to the Postgres URL Railway provides.
# DATABASE_URL=postgresql://user:pass@host:5432/db
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=change-me

# ---------- Claude (shared key; ask in team chat) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MOCK_LLM=true

# ---------- Tickets + verification (Bereket) ----------
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
TICKETMASTER_API_KEY=
MOCK_TICKETS=true
WATCH_INTERVAL_MINUTES=15
SOLARI_API_KEY=
MOCK_SOLARI=true

# ---------- Whop: NATNAEL ONLY ----------
# Natnael's Whop account receives all revenue. Only Natnael sets these, on his machine
# and in Railway. Everyone else keeps MOCK_WHOP=true.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=
WHOP_WEBHOOK_SECRET=
MOCK_WHOP=true

# ---------- Email + text (Natnael) ----------
RESEND_API_KEY=
EMAIL_FROM=Ticket Watch <alerts@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MOCK_NOTIFY=true

# ---------- Growth + research (Yared) ----------
EXA_API_KEY=
MOCK_EXA=true
TERAC_API_KEY=
MOCK_TERAC=true

# ---------- Guardrails (Bereket) ----------
STARTING_PRICE_USD=3
PRICE_MIN_USD=1
PRICE_MAX_USD=5
PRICE_CHANGE_COOLDOWN_MINUTES=60
AD_BUDGET_USD_PER_DAY=20
KILL_SWITCH=false
